@startuml
package studia.MoveHandler {
  interface MoveHandler {
    + newMove(int, int, Player) : Boolean {abstract}
  }
  class PseudoMoveHandler {
    - board : Board
    + PseudoMoveHandler(board : Board)
    + newMove(oldPos : int, newPos : int, player : Player) : Boolean
  }
  class StandardMoveHandler {
    - board : Board
    - visitedPoints : List<Point>
    + StandardMoveHandler(board : Board)
    - _getAvailableMoves(plr : Player, from : Point, cur : Point, visited : Set<Point>, ret : List<Point>) : List<Point>
    + getAvailableMoves(plr : Player, from : Point) : List<Point>
    - isMoveJump(oldPoint : Point, newPoint : Point) : Boolean
    - isMoveLeavingHome(oldPoint : Point, newPoint : Point, player : Player) : Boolean
    - isMoveToNeighbour1(oldPoint : Point, newPoint : Point) : Boolean
    - isValidMove(oldPoint : Point, newPoint : Point, player : Player) : Boolean
    + newMove(oldPos : int, newPos : int, player : Player) : Boolean
    - searchJumps(currentPoint : Point, destination : Point) : Boolean
  }
}
package studia.Server {
  class Server {
    - PORT : int
    - connected : Player[]
    - game : Game
    - interpreter : MessageInterpreter
    - nconnected : int
    - nplayers : int
    - serverSocket : ServerSocket
    - startCorner : int[]
    - variant : int
    + Server(port : int, players : int, variant : int)
    + closeConnections()
    + getConnected() : int
    + getInterpreter() : MessageInterpreter
    + getPlayersNum() : int
    + getReservedCorner(player : Player) : int
    + onClientDisconnect(client : ServerPlayer)
    + onMessage(msg : Message)
    - playerToInt(p : Player) : int
    + sendToAll(msg : int[])
    + setStartCorner(player : Player, corner : int) : boolean
    + startGame() : Game
    + waitForConnection()
    + waitForMessages()
  }
  class ServerExec {
    + ServerExec()
    + main(args : String[]) {static}
  }
  class ServerPlayer {
    - Receiver : Thread
    + disconnected : boolean
    - inStream : DataInputStream
    - outStream : DataOutputStream
    - receiver_run : boolean
    - server : Server
    - socket : Socket
    - thisref : ServerPlayer
    + ServerPlayer(server : Server, color : int)
    + closeSocket()
    + joinReceiver()
    + setSocket(s : Socket)
    + startReceiver()
    + writeMessage(args : int[])
  }
}
package studia.PawnsSpawner {
  class ChaosPawnsSpawner {
    - allowedPoints : List<Point>
    - maxPawns : int
    - pointQueue : Queue<Point>
    - rnd : Random
    - visited : Set<Point>
    + ChaosPawnsSpawner(b : Board, maxPawns : int, seed : int)
    - randomPoint() : Point
    - removeHome(startPoint : Point, npoints : int)
    + spawn(players : Player[])
    - spawnPawns(player : Player)
  }
  interface PawnsSpawner {
    + spawn(Player[]) {abstract}
  }
  class PawnsSpawnerFactory {
    - b : Board
    - pawns : int
    - seed : int
    + PawnsSpawnerFactory(board : Board, plrpawns : int, seed : int)
    + create(variant : int) : PawnsSpawner
  }
  class StandardPawnsSpawner {
    - maxPawns : int
    - pointQueue : Queue<Point>
    + StandardPawnsSpawner(maxPawns : int)
    + spawn(players : Player[])
    - spawnPawns(player : Player, startPoint : Point)
  }
}
package studia.Common {
  class BegMessage {
    - cli : Client
    - cplr : int
    - more : int
    - variant : int
    + BegMessage(args : int[], client : Client)
    + execute()
  }
  class BmovMessage {
    - client : Client
    + BmovMessage(args : int[], client : Client)
    + execute()
  }
  class ConnMessage {
    - pos : int
    - total : int
    + ConnMessage(args : int[])
    + execute()
  }
  class CornMessage {
    - client : Client
    - corner : int
    - server : Server
    + CornMessage(args : int[], server : Server, client : Client)
    + execute()
  }
  class EndMessage {
    - winner : int
    + EndMessage(args : int[])
    + execute()
  }
  class Game {
    - board : Board
    - curplr : int
    - moveHandler : MoveHandler
    - players : Player[]
    - winChecker : WinChecker
    - winner : int
    + Game(players : Player[], current : int, board : Board)
    + getCurrentPlayer() : Player
    + getWinner() : int
    + playerMove(p : int, m : Move) : boolean
    + playerMove(plr : Player, m : Move) : boolean
    + playerToColor(plr : Player) : int
  }
  class HupMessage {
    - who : int
    + HupMessage(args : int[])
    + execute()
  }
  abstract class Message {
    + MSG_BEG : int {static}
    + MSG_BMOV : int {static}
    + MSG_CONN : int {static}
    + MSG_CORN : int {static}
    + MSG_END : int {static}
    + MSG_HUP : int {static}
    + MSG_MOVE : int {static}
    + MSG_YCON : int {static}
    + MSG_YMOV : int {static}
    # handler : MessageHandler
    + nargs : int[] {static}
    # sender : Player
    + Message()
    + execute() {abstract}
    + setHandler(handler : MessageHandler)
    + setSender(sender : Player)
  }
  interface MessageHandler {
    + getCorner() : int {abstract}
    + getMove() : Move {abstract}
    + handleBeg(int, Board) {abstract}
    + handleBmov() {abstract}
    + handleConn(int, int) {abstract}
    + handleCorn(int) {abstract}
    + handleHup(int) {abstract}
    + handleMove(int, Move) {abstract}
    + handleWin(int) {abstract}
    + handleYcon(int, int, int) {abstract}
    + handleYmov() {abstract}
  }
  class MessageInterpreter {
    - client : Client
    - game : Game
    - handler : MessageHandler
    - server : Server
    + MessageInterpreter(client : Client)
    + MessageInterpreter(server : Server)
    + interpret(is : DataInputStream) : Message
    + setGame(game : Game)
    + setHandler(handler : MessageHandler)
  }
  class Move {
    + from : int
    + to : int
    + Move()
    + Move(from : int, to : int)
    + fromKeyboard()
    + toString() : String
  }
  class MoveMessage {
    - from : int
    - game : Game
    - plr : int
    - server : Server
    - to : int
    + MoveMessage(args : int[], game : Game, server : Server)
    + execute()
  }
  class StdoutMessageHandler {
    + StdoutMessageHandler()
    + getCorner() : int
    + getMove() : Move
    + handleBeg(you : int, b : Board)
    + handleBmov()
    + handleConn(pos : int, total : int)
    + handleCorn(corner : int)
    + handleHup(who : int)
    + handleMove(plr : int, m : Move)
    + handleWin(winner : int)
    + handleYcon(pos : int, total : int, variant : int)
    + handleYmov()
  }
  class YconMessage {
    - c : Client
    - pos : int
    - total : int
    - variant : int
    + YconMessage(args : int[], cli : Client)
    + execute()
  }
  class YmovMessage {
    - client : Client
    + YmovMessage(args : int[], client : Client)
    + execute()
  }
}
package studia.Board {
  class Board {
    + cornerPoints : List<Point>
    + height : int
    + length : int
    + players : Player[]
    + points : Point[][]
    + triangleSize : int
    + validPointsMap : Map<Integer, Point>
    + validPointsNumber : int
    + Board()
    + addCornerPoint(point : Point)
    + generateNeighbours1()
    + generateNeighbours2()
    + initPoints()
    + move(oldPoint : Point, newPoint : Point)
    + printBoard()
    + setHeight(height : int)
    + setLength(length : int)
    + setPlayers(players : Player[])
    + setPoint(point : Point, x : int, y : int)
    + setTriangleSize(triangleSize : int)
  }
  class BoardBuilder {
    # board : Board
    # height : int
    # length : int
    - pawnsPerPlayer : int
    - playerNumber : int
    - players : Player[]
    - seed : int
    # triangleSize : int
    - variant : int
    - yin_corners : int
    + BoardBuilder(triangleSize : int, players : Player[], pawnsPerPlayer : int)
    + build()
    + getBoard() : Board
    # initBoard()
    - initCornerPoints()
    - initFinishPoints()
    - initPlayers(playerNumber : int)
    # initPoints()
    - initValidPointsMap()
    + setSeed(seed : int)
    + setVariant(variant : int)
    + setYinCorners(corners : int)
    - spawnPawns()
  }
  class FXBoard {
    + FXBoard()
    + printBoard()
  }
  class FXBoardBuilder {
    + FXBoardBuilder(triangleSize : int, players : Player[], pawnsPerPlayer : int)
    # initPoints()
  }
  class GUIBoardBuilder {
    - board : Board
    - paneHeight : int
    - paneWidth : int
    + GUIBoardBuilder(board : Board, paneWidth : int, paneHeight : int)
    + buildBoard() : Pane
    + getPointsGroup() : Group
  }
}
package studia.winChecker {
  class StandardWinChecker {
    - countPawnsHome : int
    - pawnsPerPlayer : int
    - pointQueue : Queue<Point>
    - visitedPoints : List<Point>
    + StandardWinChecker(pawnsPerPlayer : int)
    + checkWin(player : Player) : Boolean
    - searchNeighbours(player : Player, currentPoint : Point) : Boolean
  }
  interface WinChecker {
    + checkWin(Player) : Boolean {abstract}
  }
}
package studia.Client {
  class ClientExec {
    + ClientExec()
    + main(args : String[]) {static}
  }
  class ClientFX {
    - STAGE : Stage
    - client : Client
    - gs : GameScene
    - js : JoinScene
    - ls : LobbyScene
    - ss : SelectScene
    - ycol : int
    + ClientFX()
    + getCorner() : int
    + getMove() : Move
    + handleBeg(cplr : int, b : Board)
    + handleBmov()
    + handleConn(pos : int, total : int)
    + handleCorn(corner : int)
    + handleHup(who : int)
    + handleMove(plr : int, m : Move)
    + handleWin(winner : int)
    + handleYcon(pos : int, total : int, variant : int)
    + handleYmov()
    + main(args : String[]) {static}
    + start(primaryStage : Stage)
    + stop()
    + tryConnect(host : String, port : int)
  }
  class GameScene {
    - board : Board
    - messageLabel : Label
    - move : Move
    - movhandler : StandardMoveHandler
    ~ parent : ClientFX
    - playerLabel : Label
    - scene : Scene
    - sceneHeight : int
    - sceneWidth : int
    - selectedPoints : List<FXPoint>
    ~ thisref : GameScene
    - yourTurnLabel : Label
    - yourcolor : int
    - yourturn : boolean
    ~ GameScene(parent : ClientFX, b : Board, ycol : int)
    - clearMove()
    - clearSelected()
    - decodeMove(oldPoint : FXPoint, newPoint : FXPoint) : Move
    + get() : Scene
    + getMove() : Move
    - markFinish()
    + setMyTurn(yourturn : boolean)
    - setPointsClickedEventHandler()
    + showMessage(msg : String)
  }
  class JoinScene {
    - btn : Button
    - errlabel : Label
    - host : TextField
    ~ parent : ClientFX
    - port : TextField
    - scene : Scene
    ~ JoinScene(parent : ClientFX)
    + get() : Scene
    - onClick()
    + printError(error : String)
  }
  class LobbyScene {
    - label1 : Label
    - label2 : Label
    - label3 : Label
    ~ parent : ClientFX
    - plr : int
    - scene : Scene
    - total : int
    ~ LobbyScene(parent : ClientFX)
    + get() : Scene
    + updatePlayers(n : int, t : int)
    + updateVariant(v : int)
  }
  class SelectScene {
    - btn : Button
    - errlabel : Label
    - host : TextField
    ~ parent : ClientFX
    - polygons : Polygon[]
    - port : TextField
    - scene : Scene
    - selected : int
    ~ SelectScene(parent : ClientFX)
    + get() : Scene
    + getCorner() : int
    + setReserved(pos : int)
  }
}
